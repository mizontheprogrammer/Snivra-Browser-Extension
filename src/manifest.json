{
  "manifest_version": 3,
  "name": "Snivra — Screenshot to Text",
  "version": "0.4.1",
  "description": "Paste or open a screenshot and turn it into editable text locally.",
  "permissions": ["clipboardRead", "clipboardWrite"],
  "action": {
    "default_title": "Snivra",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'self'"
  }
}
